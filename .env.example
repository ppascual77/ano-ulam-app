EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# CLI-only (no EXPO_PUBLIC_ prefix — never bundled into the app). Used to run
# `supabase db push --db-url` and to regenerate lib/database.types.ts via the
# Management API. See that file's header comment for why (Docker isn't
# available locally, and CLI account login currently rejects sbp_v0_ tokens).
# SUPABASE_DB_URL: Settings > Database > Connect > "Session pooler" URI
#   (not the direct db.<ref>.supabase.co host — IPv6-only, often unreachable).
# SUPABASE_ACCESS_TOKEN: supabase.com/dashboard/account/tokens (account-wide
#   scope — broader than a project key, handle accordingly).
# SUPABASE_PROJECT_REF: the subdomain in the project URL above.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
